# قاعدة البيانات
DATABASE_URL=postgresql://ataeru_user:ataeru_password@localhost:5432/ataeru_db

# Redis (الـ queue و caching)
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# الأمان JWT
SECRET_KEY=change-me-to-a-very-long-random-secret-key-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# البريد الإلكتروني (للتأكيد - اختياري حالياً)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@ataeru.com

# عنوان الخادم
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]